{
  "expo": {
    "name": "Casa Club Tigres",
    "slug": "casa-club",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "casaclub",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "mx.casaclub.femenil",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "mx.casaclub.femenil",
      "adaptiveIcon": {
        "backgroundColor": "#0B2265",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B2265",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Casa Club necesita la cámara para leer el QR de las jugadoras."
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Casa Club necesita tus fotos para adjuntar comidas y reportes.",
          "cameraPermission": "Casa Club necesita la cámara para tomar fotos de comidas y reportes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8df03fdb-ad23-46fa-8551-9703c863c8bd"
      }
    },
    "owner": "geboou"
  }
}
